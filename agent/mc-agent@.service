[Unit]
Description=MC Server TG Bot Agent - %i
After=network.target

[Service]
# User running the Minecraft server (highly recommended not to run as root!)
User=minecraft

# Each instance loads its own config from /etc/mc-agent/<instance>.env
# Example: mc-agent@survival loads /etc/mc-agent/survival.env
EnvironmentFile=/etc/mc-agent/%i.env

WorkingDirectory=/opt/mc/agent
ExecStart=/usr/bin/python3 mc_agent.py \
  --port ${MC_AGENT_PORT} \
  --api-key ${MC_AGENT_API_KEY} \
  --server-path ${MC_AGENT_SERVER_PATH} \
  --start-script ${MC_AGENT_START_SCRIPT} \
  --screen-session ${MC_AGENT_SCREEN_SESSION}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
